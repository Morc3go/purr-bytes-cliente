enunciado = "e contra o cachorro VERDE que patrulha aqui embaixo, qual delas serve?"
opcoes = PackedStringArray("CESAR", "VIGENERE")
explicacao_correta = "verde continua sendo Cesar, mesmo numa fase de Vigenere: a cor manda, nao a fase."

[resource]
script = ExtResource("4_y6c6o")
numero = 2
titulo = "o labirinto de Vigenere"
