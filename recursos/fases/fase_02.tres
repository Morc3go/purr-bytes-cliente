velocidade_cachorro = 42.0
briefing_pedagogico = "o pacote precisa atravessar o labirinto ate a saida, do outro lado do mapa.
a chave desta vez e uma palavra, nao um numero: 'cifrar <pacote> chave=<palavra>'.
o cachorro nao sabe onde voce esta -- mas errar no terminal ou ser visto de perto entrega pistas de qual regiao do mapa voce esta."
texto_exemplo_demonstracao = "mensagem"
chave_exemplo_demonstracao = "chave"
faixa_chave_minima = 3
faixa_chave_maxima = 8
