[sub_resource type="Resource" id="Resource_vqhxv"]
script = ExtResource("4_opoan")
identificador = "f2-aplicacao"
enunciado = "o cachorro que patrulha esta passagem e VERDE. qual ferramenta protege o pacote dele?"
opcoes = PackedStringArray("CESAR", "VIGENERE")
explicacao_correta = "verde continua pedindo a mesma ferramenta de sempre, mesmo numa fase nova: quem manda e a cor, nao a fase."

[sub_resource type="Resource" id="Resource_g65dx"]
script = ExtResource("4_opoan")
identificador = "f2-conceito"
enunciado = "nesta fase a chave e uma palavra em vez de um numero. o que isso muda no embaralhamento?"
tipo = "CONCEITO"
opcoes = PackedStringArray("cada letra anda um tanto diferente, seguindo a palavra", "o texto cifrado fica com o mesmo tamanho da palavra", "a palavra e escondida dentro do proprio pacote")
resposta_correta = "cada letra anda um tanto diferente, seguindo a palavra"
explicacao_correta = "isso. um numero so move todas as letras igual; a palavra troca o deslocamento a cada posicao."

[sub_resource type="Resource" id="Resource_o5s18"]
script = ExtResource("4_opoan")
identificador = "f2-discernimento"
enunciado = "contar quais letras mais se repetem ajuda a quebrar um deslocamento fixo. por que isso para de funcionar aqui?"
tipo = "DISCERNIMENTO"
opcoes = PackedStringArray("a mesma letra vira letras diferentes em cada posicao", "o texto cifrado passa a nao ter letras repetidas", "a contagem so funciona em textos muito curtos")
resposta_correta = "a mesma letra vira letras diferentes em cada posicao"
explicacao_correta = "exato: sem repeticao previsivel, contar letras nao entrega mais nada."

[resource]
script = ExtResource("5_ri1oo")
numero = 2
titulo = "o labirinto de Vigenere"
algoritmo = "VIGENERE"
verbos_permitidos = PackedStringArray("cifrar", "decifrar", "dica", "status")
mapa = SubResource("Resource_wpv2t")
desafios = Array[ExtResource("2_5oi4k")]([SubResource("Resource_asqx5"), SubResource("Resource_kyf4m"), SubResource("Resource_t3mgo")])
