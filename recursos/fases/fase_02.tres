[sub_resource type="Resource" id="Resource_kyf4m"]
script = ExtResource("3_5oi4k")
identificador = "vigenere-norte"
celula = Vector2i(15, 1)
enunciado = "um cachorro AZUL bloqueia a saida deste corredor. qual cifra o engana?"
opcoes = PackedStringArray("CESAR", "VIGENERE")
resposta_correta = "VIGENERE"
explicacao_correta = "azul = Vigenere. a cifra verde de Cesar nao adianta contra ele."

[sub_resource type="Resource" id="Resource_t3mgo"]
script = ExtResource("3_5oi4k")
identificador = "vigenere-centro"
celula = Vector2i(9, 5)
enunciado = "qual das duas resiste a analise de frequencia, por trocar o deslocamento a cada letra?"
opcoes = PackedStringArray("CESAR", "VIGENERE")
resposta_correta = "VIGENERE"
explicacao_correta = "Vigenere: a chave-palavra muda o deslocamento posicao a posicao, entao contar letras repetidas nao entrega mais a cifra."

[sub_resource type="Resource" id="Resource_wpv2t"]
