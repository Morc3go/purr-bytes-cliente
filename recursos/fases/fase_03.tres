[sub_resource type="Resource" id="Resource_ol6pa"]
script = ExtResource("4_vle6f")
identificador = "f3-aplicacao"
enunciado = "um cachorro AZUL apareceu no corredor de baixo. qual das tres ferramentas protege o pacote dele?"
opcoes = PackedStringArray("CESAR", "VIGENERE", "SHA256")
resposta_correta = "VIGENERE"
explicacao_correta = "isso. e repare: a ferramenta nova desta fase nao esconde nada, entao ela nao serviria aqui."

[sub_resource type="Resource" id="Resource_snekf"]
script = ExtResource("4_vle6f")
identificador = "f3-conceito"
enunciado = "voce mudou UMA letra do pacote e o resumo saiu completamente diferente. o que isso mostra?"
tipo = "CONCEITO"
opcoes = PackedStringArray("qualquer alteracao no conteudo aparece na hora", "que a chave usada estava errada", "que o pacote foi protegido duas vezes seguidas")
resposta_correta = "qualquer alteracao no conteudo aparece na hora"
explicacao_correta = "exato -- e para isso que o resumo serve: conferir se o conteudo chegou intacto."

[sub_resource type="Resource" id="Resource_eajtu"]
script = ExtResource("4_vle6f")
identificador = "f3-discernimento"
enunciado = "qual destas NAO serve para esconder um conteudo que precisa ser lido de volta depois?"
opcoes = PackedStringArray("CESAR", "VIGENERE", "SHA256")
resposta_correta = "SHA256"
explicacao_correta = "isso. nao existe desfazer um resumo: as outras duas embaralham e devolvem o texto; esta so confere."

[resource]
script = ExtResource("5_15727")
numero = 3
titulo = "o labirinto de SHA-256"
algoritmo = "SHA256"
verbos_permitidos = PackedStringArray("hash", "verificar", "cifrar", "dica", "status")
mapa = SubResource("Resource_81voo")
desafios = Array[ExtResource("2_5841i")]([SubResource("Resource_c6um6"), SubResource("Resource_6mcfx"), SubResource("Resource_bwu2f"), SubResource("Resource_evluw")])
cachorros = Array[ExtResource("1_thhan")]([SubResource("Resource_hyxck"), SubResource("Resource_jahtl"), SubResource("Resource_qr3ng")])
pacotes = Array[ExtResource("4_vle6f")]([SubResource("Resource_ol6pa"), SubResource("Resource_snekf"), SubResource("Resource_eajtu")])
velocidade_cachorro = 44.0
briefing_pedagogico = "o pacote chega com um digest anexado -- um resumo de mao unica do conteudo.
use 'hash <palavra>' para calcular o digest de verdade, e 'verificar <palavra> <prefixo>' para confirmar que o pacote nao foi adulterado antes de entregar.
hash nao se desfaz: nao ha 'dehash'. serve para conferir, nao para esconder."
texto_exemplo_demonstracao = "exemplo"
