[sub_resource type="Resource" id="Resource_hcn5s"]
script = ExtResource("2_a3w8w")
identificador = "cesar-01"
enunciado = "o pacote 'pacote' precisa de protecao. desloque 3 posicoes: cifrar pacote chave=3"
texto_claro = "pacote"
chave_esperada = "3"
dica = "conte 3 letras a frente de cada letra: 'p'->'s', 'a'->'d' ..."
pontos_acerto_de_primeira = 150

[sub_resource type="Resource" id="Resource_tf0sd"]
script = ExtResource("2_a3w8w")
identificador = "cesar-02"
enunciado = "novo pacote 'rede' atravessando. desta vez o deslocamento e outro: cifrar rede chave=5"
texto_claro = "rede"
chave_esperada = "5"
dica = "desloque 5 posicoes desta vez, nao 3 -- cada pacote pode usar uma chave diferente."
pontos_acerto_de_primeira = 150

[sub_resource type="Resource" id="Resource_yxpfl"]
script = ExtResource("3_llbwm")
identificador = "cesar-ne"
celula = Vector2i(21, 2)
enunciado = "este pacote precisa atravessar o corredor onde ronda um cachorro VERDE. qual cifra o protege ali?"
opcoes = PackedStringArray("CESAR", "VIGENERE", "SHA256")
explicacao_correta = "isso. verde = Cesar: cada cor de cachorro le uma cifra so, e cifrar na cor errada nao protege."

[sub_resource type="Resource" id="Resource_jesxa"]
script = ExtResource("3_llbwm")
identificador = "cesar-centro"
celula = Vector2i(11, 8)
enunciado = "na cifra de Cesar, o que exatamente e a chave que voce digita no terminal?"
opcoes = PackedStringArray("CESAR", "VIGENERE", "SHA256")
explicacao_correta = "a chave de Cesar e um NUMERO: quantas casas cada letra anda no alfabeto. as outras cifras usam outra coisa."

[sub_resource type="Resource" id="Resource_ow3gu"]
script = ExtResource("3_llbwm")
identificador = "cesar-so"
celula = Vector2i(2, 15)
enunciado = "um pacote em texto claro foi interceptado no caminho. que ferramenta teria impedido a leitura do conteudo?"
opcoes = PackedStringArray("CESAR", "SHA256")
explicacao_correta = "cifra esconde o conteudo; hash nao esconde nada, so prova que o conteudo nao mudou. voce vai usar hash na fase 3."

[resource]
script = ExtResource("4_lw3ls")
titulo = "o labirinto de Cesar"
verbos_permitidos = PackedStringArray("cifrar", "decifrar", "dica", "status")
desafios = Array[ExtResource("2_a3w8w")]([SubResource("Resource_hcn5s"), SubResource("Resource_tf0sd")])
cachorros = Array[ExtResource("1_4v4o1")]([SubResource("Resource_36ouy"), SubResource("Resource_3ppbp")])
pacotes = Array[ExtResource("3_llbwm")]([SubResource("Resource_yxpfl"), SubResource("Resource_jesxa"), SubResource("Resource_ow3gu")])
velocidade_cachorro = 40.0
briefing_pedagogico = "o pacote precisa atravessar o labirinto ate a saida.
em texto claro, o cachorro fareja e intercepta -- use 'cifrar <pacote> chave=<numero>' para proteger, 'dica' se travar, 'status' para reler o desafio atual."
faixa_chave_maxima = 25
